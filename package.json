{
	"name": "bopa_mono",
	"version": "1.0.0",
	"description": "The mono-repo for the boilerplate creator bopa",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/charlyoleg2/bopa_mono.git"
	},
	"homepage": "https://charlyoleg2.github.io/bopa_mono/",
	"author": "charlyoleg2",
	"license": "ISC",
	"keywords": [
		"boilerplate",
		"ref-repo",
		"ui"
	],
	"type": "module",
	"workspaces": [
		"pkg/*"
	],
	"scripts": {
		"bopa-ui:dev": "npm -w bopa-ui run dev",
		"bopa-ui:ci": "npm -w bopa-ui run ci",
		"bopa-ui:clean": "npm -w bopa-ui run clean",
		"bopa-ui:preview": "npm -w bopa-ui run preview",
		"bopa-ui:version": "npm -w bopa-ui version patch",
		"bopac:ci": "npm -w bopac run ci",
		"bopac:copy_public": "npm -w bopac run copy_public",
		"bopac:run": "npm -w bopac run run",
		"bopac:clean": "npm -w bopac run clean",
		"bopac:version": "npm -w bopac version patch",
		"ci": "run-s bopa-ui:ci bopac:ci",
		"ci2": "run-s bopa-ui:ci",
		"clean-root": "rimraf tmp output output2 build",
		"clean": "run-s clean-root bopa-ui:clean bopac:clean",
		"preview": "run-p bopa-ui:preview",
		"run": "run-s bopac:run",
		"versions": "run-s bopa-ui:version bopac:version",
		"ls-workspaces": "npm -ws exec -c pwd",
		"ls-pkg": "ls -la pkg"
	},
	"devDependencies": {
		"npm-run-all2": "^9.0.4",
		"rimraf": "^6.1.3"
	}
}
