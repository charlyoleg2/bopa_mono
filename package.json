{
	"name": "bopa_mono",
	"version": "1.0.0",
	"description": "The mono-repo for the boilerplate creator bopa",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/charlyoleg2/bopa_mono.git"
	},
	"homepage": "https://charlyoleg2.github.io/bopa_mono/",
	"author": "charlyoleg2",
	"license": "ISC",
	"keywords": [
		"boilerplate",
		"ref-repo",
		"ui"
	],
	"type": "module",
	"workspaces": [
		"pkg/*"
	],
	"scripts": {
		"bopa-ui:dev": "npm -w bopa-ui run dev",
		"bopa-ui:ci": "npm -w bopa-ui run ci",
		"bopa-ui:clean": "npm -w bopa-ui run clean",
		"bopa-ui:preview": "npm -w bopa-ui run preview",
		"bopa-ui:version": "npm -w bopa-ui version patch",
		"bopa-cli:ci": "npm -w bopa-cli run ci",
		"bopa-cli:copy_public": "npm -w bopa-cli run copy_public",
		"bopa-cli:run": "npm -w bopa-cli run run",
		"bopa-cli:clean": "npm -w bopa-cli run clean",
		"bopa-cli:version": "npm -w bopa-cli version patch",
		"ci": "run-s bopa-ui:ci",
		"ci2": "run-s bopa-ui:ci bopa-cli:ci",
		"clean-root": "rimraf tmp output output2 build",
		"clean": "run-s clean-root bopa-ui:clean bopa-cli:clean",
		"preview": "run-p bopa-ui:preview",
		"run-uis": "run-s bopa-cli:run",
		"versions": "run-s bopa-ui:version bopa-cli:version",
		"ls-workspaces": "npm -ws exec -c pwd",
		"ls-pkg": "ls -la pkg"
	},
	"devDependencies": {
		"npm-run-all2": "^9.0.4",
		"rimraf": "^6.1.3"
	}
}
